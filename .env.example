# Port the web dashboard/pairing server should run on.
# Most hosts (Render, Koyeb, Railway) inject this automatically —
# you usually don't need to set it yourself.
PORT=3000

# WhatsApp number allowed to use owner-only commands (with country code, no +).
OWNER_NUMBER=254700000000

# Optional: your own Giphy API key. Falls back to a public demo key if unset.
GIPHY_API_KEY=
