# Port the web dashboard/pairing server should run on.
# Most hosts (Render, Koyeb, Railway) inject this automatically —
# you usually don't need to set it yourself.
PORT=3000

# Legacy compatibility value; privileged checks resolve from each active WhatsApp session.
OWNER_NUMBER=

# Unlimited multi-session is the default. Set a positive integer only if you intentionally want a cap.
MAX_BOT_INSTANCES=unlimited

# Durable storage: point these at a persistent Railway volume or VPS directory.
# Each account receives an isolated child directory under MULTI_USER_AUTH_DIR.
MULTI_USER_AUTH_DIR=/data/meshtech/auth_sessions
# The bot's durable JSON state file.
MULTI_USER_DATA_FILE=/data/meshtech/data/bot_data.json

# Optional: your own Giphy API key. Falls back to a public demo key if unset.
GIPHY_API_KEY=
